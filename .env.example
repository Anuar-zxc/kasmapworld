# Copy to .env and adjust.  Never commit real credentials.
KASMAP_DATABASE_URL=postgresql://kasmap:kasmap@localhost:5432/kasmap
KASMAP_DATA_ROOT=./data
# Pin the Overture release; check https://docs.overturemaps.org/release/ for newer ones.
KASMAP_OVERTURE_RELEASE=2026-08-19.0
KASMAP_OVERTURE_S3_ROOT=s3://overturemaps-us-west-2/release
KASMAP_OVERTURE_S3_REGION=us-west-2
KASMAP_GEOFABRIK_ROOT=https://download.geofabrik.de
KASMAP_MAX_ATTEMPTS=3
